{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "runtime": "python3.11",
      "maxDuration": 800,
      "memory": 1024,
      "includeFiles": "{lib/python/**,data/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ]
}
